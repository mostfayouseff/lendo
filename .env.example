# ─── Apex MEV Platform — Environment Variables ───────────────────────────────
# Copy this file to .env and fill in all required values.
# Never commit the real .env file.

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:password@localhost:5432/apexdb

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── API Server ───────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8080

# ─── JWT Authentication ────────────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_long_random_secret_at_least_64_chars
JWT_ACCESS_EXPIRY_MINUTES=15
JWT_REFRESH_EXPIRY_DAYS=7

# ─── Initial Admin Credentials ────────────────────────────────────────────────
ADMIN_EMAIL=admin@apex.local
ADMIN_PASSWORD=changeme

# ─── Solana RPC ───────────────────────────────────────────────────────────────
APEX_HTTP_RPC_URL=https://api.mainnet-beta.solana.com
APEX_RPC_URL=wss://api.mainnet-beta.solana.com

# ─── Ingress (at least one required) ─────────────────────────────────────────
HELIUS_API_KEY=
ALCHEMY_API_KEY=

# ─── Jupiter ──────────────────────────────────────────────────────────────────
JUPITER_API_KEY=

# ─── Jito ─────────────────────────────────────────────────────────────────────
JITO_TIP_ACCOUNT=96gYZGLnJYVFmbjzopPSU6QiEV5fGqZNyN9nmNhvrZU5
JITO_TIP_LAMPORTS=1000

# ─── MEV Bot Settings ─────────────────────────────────────────────────────────
APEX_SIMULATION_ONLY=true
APEX_KEYPAIR_PATH=live-key.json
APEX_MIN_PROFIT_LAMPORTS=10000
APEX_MAX_HOPS=4
APEX_MAX_POSITION_LAMPORTS=1000000000

# ─── Logging ──────────────────────────────────────────────────────────────────
RUST_LOG=info

# ─── Integration Tests ────────────────────────────────────────────────────────
TEST_API_URL=http://localhost:8080

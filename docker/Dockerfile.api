FROM rust:1.82-slim-bookworm AS builder

RUN apt-get update && apt-get install -y \
    pkg-config libssl-dev libpq-dev ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build

COPY Cargo.toml Cargo.lock ./
COPY crates/ crates/
COPY database/ database/

RUN cargo build --release --bin apex-api 2>&1

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y ca-certificates libssl3 libpq5 \
    && rm -rf /var/lib/apt/lists/*

RUN useradd -r -s /bin/false apex
WORKDIR /app

COPY --from=builder /build/target/release/apex-api /app/apex-api
COPY database/ /app/database/

USER apex
EXPOSE 8080
ENTRYPOINT ["/app/apex-api"]
